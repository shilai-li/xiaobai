# Build output (compiled per project_file/makefile, BUILD_DIR = project_file/build)
**/project_file/build/

# Generated firmware binaries (assembled from build output, not source assets)
**/firmware/user_code/

# Compiler/linker intermediates, wherever they land
*.o
*.obj
*.elf
*.map
*.lst
*.d

# IDE/editor
.vscode/*
!.vscode/settings.json

# SDK / IDE project artifacts
/SI/
*.si4project
*.IAB
*.IAD
*.IMB
*.PFI
*.PO
*.PR
*.PRI
*.PS
*.WK3
*.prefs
*.SearchResults
language.settings.xml

# Generated build and voice-model artifacts
**/source_file.mk
/build_temp/
asr.bin
dnn.bin
user_code.bin
user_file.bin
*.xls.bin
*.xlsx.bin
\[0\]code.bin

# Firmware files regenerated by the SDK build.  Keep pretrained DNN models,
# OTA images, and release images under version control.
**/firmware/asr/asr.bin
**/firmware/dnn/dnn.bin
**/firmware/user_file/**/*.bin
**/firmware/voice/voice.bin
**/project_file/build/

# Eclipse / SDK workspace metadata
/.metadata/
